# 시스템 기본 설정
NODE_ENV=development
TZ=Asia/Seoul
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 데이터베이스 설정 (Prisma 7)
DATABASE_URL="postgresql://user:password@localhost:5432/beauty_db?schema=public"

# 세션 및 보안 비밀키
SESSION_SECRET="super-secret-session-key-change-in-production-min-32-chars"

# Google Drive OAuth 설정
GOOGLE_OAUTH_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_OAUTH_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_OAUTH_REFRESH_TOKEN="your_google_oauth_refresh_token"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"
