// Prisma 7 Schema for 미용학원 연습 기록 사이트
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. 강사 / 관리자 계정
enum Role {
  ADMIN
  TEACHER
}

model Teacher {
  id           String   @id @default(cuid())
  loginId      String   @unique
  name         String
  passwordHash String
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes           Class[]             @relation("ClassTeacher")
  settingLogs       SettingChangeLog[]

  @@map("teachers")
}

// 2. 반 (Class)
model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  joinToken   String   @unique
  isActive    Boolean  @default(true)
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher Teacher @relation("ClassTeacher", fields: [teacherId], references: [id])

  settingVersions    ClassSettingVersion[]
  enrollments        Enrollment[]
  practiceGoals      PracticeGoal[]
  schedules          ClassSchedule[]
  scheduleExceptions ScheduleException[]
  sessions           ClassSession[]
  submissions        Submission[]
  settingLogs        SettingChangeLog[]

  @@index([teacherId])
  @@index([isActive])
  @@map("classes")
}

// 3. 반 설정 버전 (다음 수업 적용 원칙)
model ClassSettingVersion {
  id                 String   @id @default(cuid())
  classId            String
  version            Int      @default(1)
  name               String
  description        String?
  preEntryMinutes    Int      @default(10) // 사전 접속 허용시간(분)
  gracePeriodMinutes Int      @default(10) // 제출 유예시간(분)
  maxFilesPerSub     Int      @default(5)  // 파일 개수 제한
  maxFileSizeMB      Int      @default(10) // 파일 용량 제한(MB)
  changedById        String
  createdAt          DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessions ClassSession[]

  @@unique([classId, version])
  @@map("class_setting_versions")
}

// 4. 학생 (Student)
model Student {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  sessions    StudentSession[]
  submissions Submission[]

  @@index([name])
  @@index([isBlocked])
  @@map("students")
}

// 5. 학생 - 반 수강 연결 (Enrollment)
model Enrollment {
  id         String    @id @default(cuid())
  classId    String
  studentId  String
  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([classId, droppedAt])
  @@map("enrollments")
}

// 6. 학습 목표
model PracticeGoal {
  id          String   @id @default(cuid())
  classId     String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  submissions Submission[]

  @@unique([classId, name])
  @@index([classId, isActive])
  @@map("practice_goals")
}
// 7. 정규 시간표 (ClassSchedule)
model ClassSchedule {
  id                 String   @id @default(cuid())
  classId            String
  dayOfWeek          Int      // 0: 일요일, 1: 월요일 ... 6: 토요일
  startTime          String   // "14:00"
  endTime            String   // "16:00"
  preEntryMinutes    Int      @default(10)
  gracePeriodMinutes Int      @default(10)
  createdAt          DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_schedules")
}

// 8. 시간표 예외사항 (ScheduleException: 휴강, 보강, 임시수업)
enum ExceptionType {
  CANCEL     // 휴강
  ADDITIONAL // 보강 / 임시수업
}

model ScheduleException {
  id            String        @id @default(cuid())
  classId       String
  date          DateTime      // YYYY-MM-DD
  type          ExceptionType
  startTime     String?       // "14:00" (ADDITIONAL 인 경우)
  endTime       String?       // "16:00"
  reason        String?
  createdAt     DateTime      @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("schedule_exceptions")
}

// 9. 실제 수업 회차 및 설정 스냅샷 (ClassSession)
enum SessionStatus {
  SCHEDULED // 예정됨
  OPEN      // 진행 중
  EXTENDED  // 시간 연장됨
  CLOSED    // 마감됨
}

model ClassSession {
  id                 String        @id @default(cuid())
  classId            String
  settingVersionId   String?
  date               DateTime      // 수업 날짜
  scheduledStartTime DateTime      // 정규 시작 시각
  scheduledEndTime   DateTime      // 정규 종료 시각
  actualAllowedStart DateTime      // 실제 사전 접속 포함 허용 시작 시각
  actualAllowedEnd   DateTime      // 실제 유예/연장 포함 허용 종료 시각
  status             SessionStatus @default(SCHEDULED)
  snapshotData       String        @db.Text // 수업 시작 시점의 반 설정/학생명단/목표 스냅샷 JSON
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  settingVersion ClassSettingVersion? @relation(fields: [settingVersionId], references: [id])

  studentSessions   StudentSession[]
  submissions       Submission[]

  @@map("class_sessions")
}

// 10. 학생 수업 접속 세션 (StudentSession)
model StudentSession {
  id             String   @id @default(cuid())
  classSessionId String
  studentId      String
  token          String   @unique
  expiresAt      DateTime
  isValid        Boolean  @default(true)
  createdAt      DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_sessions")
}

// 11. 연습 결과 제출 (Submission - 텍스트 한달 보관)
model Submission {
  id               String   @id @default(cuid())
  classId          String
  classSessionId   String
  studentId        String
  practiceGoalId   String

  goalName         String
  durationSeconds  Int
  memo             String?  @db.Text

  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  classSession ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceGoal PracticeGoal  @relation(fields: [practiceGoalId], references: [id], onDelete: Restrict)

  files SubmissionFile[]

  @@index([classId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([practiceGoalId, submittedAt])
  @@index([classSessionId])
  @@map("submissions")
}

// 12. 첨부파일 기록 (SubmissionFile - 1개월 보관 후 삭제)
model SubmissionFile {
  id           String    @id @default(cuid())
  submissionId String
  googleFileId String    @unique
  fileName     String
  fileSize     Int
  mimeType     String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([isDeleted, createdAt])
  @@map("submission_files")
}

// 13. 반 설정 변경 이력 로그 (SettingChangeLog)
model SettingChangeLog {
  id          String   @id @default(cuid())
  classId     String
  teacherId   String
  changeType  String   // "SCHEDULE", "STUDENT_LIST", "FILE_LIMIT" 등
  beforeValue String   @db.Text
  afterValue  String   @db.Text
  appliedFrom String   // 적용 시작 수업 회차 정보
  createdAt   DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("setting_change_logs")
}


// 15. 자동 Cleanup 작업 결과 로그 (CleanupLog)
enum CleanupType {
  MONTHLY_RETENTION
}

model CleanupLog {
  id           String      @id @default(cuid())
  type         CleanupType
  status       String      // "SUCCESS", "PARTIAL_FAILURE", "FAILED"
  targetCount  Int         @default(0)
  deletedCount Int         @default(0)
  failCount    Int         @default(0)
  details      String?     @db.Text // 상세 에러 및 대상 ID 로그
  executedAt   DateTime    @default(now())

  @@map("cleanup_logs")
}


enum ExportStatus {
  GENERATED
  DOWNLOADED
  CLEANUP_COMPLETED
  FAILED
}

// 엑셀 내보내기 상태 추가
model MonthlyExportLog {
  id              String       @id @default(cuid())
  periodKey       String
  scopeKey        String       @default("ALL") // 전체 내보내기: ALL, 강사별 내보내기: 강사 ID
  periodStart     DateTime
  periodEnd       DateTime
  status          ExportStatus @default(GENERATED)

  submissionCount Int          @default(0)
  fileCount       Int          @default(0)

  generatedAt     DateTime     @default(now())
  downloadedAt    DateTime?
  dbDeletedAt     DateTime?
  driveDeletedAt  DateTime?
  errorMessage    String?      @db.Text
  updatedAt       DateTime     @updatedAt

  @@unique([periodKey, scopeKey])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([scopeKey])
  @@map("monthly_export_logs")
}
